.env

# Node modules
node_modules/

# Build files
build/
dist/

# Log files
*.log

# Mac system files
.DS_Store

# Backup files made along the way — not real migration history
backup_before_*.sql
*_backup.sql

# Diagnostic dumps — not meant to be committed
local_schema_dump.sql

# Leftover/duplicate file copies
*0.js
*.updated.jsx

# Actual uploaded tenant/listing files — keep the folder, not its contents
backend/uploads/*
!backend/uploads/.gitkeep